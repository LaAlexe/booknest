generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  AVAILABLE
  RESERVED
  BORROWED
}

enum ReservationStatus {
  RESERVED
  BORROWED
  COMPLETED
  CANCELLED
}

enum ContentLocale {
  en
  uk
}

model Genre {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique @db.VarChar(100)
  books        Book[]
  translations GenreTranslation[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@map("genres")
}

model GenreTranslation {
  id        String        @id @default(uuid()) @db.Uuid
  genreId   String        @map("genre_id") @db.Uuid
  genre     Genre         @relation(fields: [genreId], references: [id], onDelete: Cascade)
  locale    ContentLocale
  name      String        @db.VarChar(100)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([genreId, locale])
  @@index([locale, name])
  @@map("genre_translations")
}

model Book {
  id           String            @id @default(uuid()) @db.Uuid
  coverUrl     String?           @map("cover_url") @db.VarChar(2048)
  coverKey     String?           @map("cover_key") @db.VarChar(1024)
  status       BookStatus        @default(AVAILABLE)
  genreId      String            @map("genre_id") @db.Uuid
  genre        Genre             @relation(fields: [genreId], references: [id], onDelete: Restrict)
  translations BookTranslation[]
  reservations Reservation[]
  isArchived   Boolean           @default(false) @map("is_archived")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([isArchived, createdAt])
  @@index([genreId, isArchived])
  @@index([status])
  @@map("books")
}

model BookTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  bookId      String        @map("book_id") @db.Uuid
  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  locale      ContentLocale
  title       String        @db.VarChar(255)
  author      String        @db.VarChar(255)
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([bookId, locale])
  @@index([locale, title])
  @@index([locale, author])
  @@map("book_translations")
}

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  bookId             String            @map("book_id") @db.Uuid
  book               Book              @relation(fields: [bookId], references: [id], onDelete: Restrict)
  requesterName      String            @map("requester_name") @db.VarChar(150)
  telegramUsername   String            @map("telegram_username") @db.VarChar(33)
  status             ReservationStatus @default(RESERVED)
  reservedAt         DateTime          @default(now()) @map("reserved_at")
  borrowedAt         DateTime?         @map("borrowed_at")
  returnedAt         DateTime?         @map("returned_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason") @db.Text
  handledByAdminId   String?           @map("handled_by_admin_id") @db.Uuid
  handledByAdmin     AdminUser?        @relation(fields: [handledByAdminId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([bookId])
  @@index([status])
  @@index([handledByAdminId])
  @@map("reservations")
}

model AdminUser {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique @db.VarChar(320)
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  sessions            AdminSession[]
  handledReservations Reservation[]
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
